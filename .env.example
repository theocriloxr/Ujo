# DATABASE_URL: Path to the SQLite database file
DATABASE_URL="file:./ujo.db"

# HOME ASSISTANT CONFIG
HA_URL="http://localhost:8123"
HA_TOKEN="YOUR_LONG_LIVED_ACCESS_TOKEN"

# SECURITY CONFIG
JWT_SECRET="super_secure_random_string_change_in_production"
UJO_OWNER_PIN="1234"
UJO_DURESS_PIN="9999"
UJO_STAFF_PIN="2468"
UJO_BRIDGE_TOKEN="generate_a_unique_random_token_of_at_least_32_characters"
UJO_ADMIN_EMAIL="owner@example.com"
UJO_ADMIN_PASSWORD="replace-with-a-unique-long-password"

# OFFLINE AI (pi, mini, or workstation selects a safe default model)
UJO_HUB_PROFILE="mini"
OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="qwen3:4b"

# LOCAL VOICE (HTTP adapter returning WAV bytes or JSON audio)
LOCAL_TTS_URL="http://127.0.0.1:10200/synthesize"
LOCAL_TTS_VOICE="en_GB-alan-medium"
LOCAL_TTS_TIMEOUT_MS="15000"
ALLOW_CLOUD_VOICE="false"
LOCAL_STT_URL="http://127.0.0.1:10300/transcribe"
LOCAL_STT_TIMEOUT_MS="60000"
LOCAL_STT_MODEL="small.en"

# HARDWARE BUS: unique 32+ character secret per provisioned node
MQTT_BROKER="mqtts://localhost:8883"
MQTT_CA_PATH="/run/secrets/mqtt-ca.crt"
UJO_NODE_KEYS_JSON='{"ujo-kitchen-01":"replace-with-a-unique-32-character-node-secret"}'
ALLOW_LEGACY_MQTT="false"
UJO_SIM_NODE_SECRET="development-only-simulator-secret-32chars"
TELEMETRY_RETENTION_DAYS="90"

# WHATSAPP DISPATCH CONFIG (Meta / Twilio)
WHATSAPP_API_KEY="your_meta_or_twilio_api_key"
VENDOR_DIESEL_CONTACT="+2348000000000"

# VISION AI CONFIG (YOLOv8 Edge Model)
VISION_API_URL="http://localhost:5000/predict"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
APP_ORIGINS="https://ujo-home.local,capacitor://localhost"
# Native shells load the authenticated HTTPS hub origin; set this when running Capacitor commands.
UJO_MOBILE_SERVER_URL="https://ujo-home.local"
