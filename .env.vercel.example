# Build-time Vite switch. Set for Preview and Production, then redeploy.
VITE_UJO_GATEWAY=true

# PREVIEW MODE: fixes login on Vercel and provides a read-only interface demonstration.
UJO_GATEWAY_MODE=preview
UJO_GATEWAY_JWT_SECRET=replace-with-at-least-32-random-characters
UJO_PREVIEW_ADMIN_EMAIL=owner@example.com
UJO_PREVIEW_ADMIN_PASSWORD=replace-with-at-least-12-characters

# REAL HUB MODE: replace preview with proxy after the hub has a stable HTTPS URL.
# UJO_GATEWAY_MODE=proxy
# UJO_REMOTE_HUB_URL=https://hub.example.com
# UJO_GATEWAY_TIMEOUT_MS=30000
# Optional but recommended when the tunnel is protected by Cloudflare Access:
# UJO_CF_ACCESS_CLIENT_ID=service-token-client-id
# UJO_CF_ACCESS_CLIENT_SECRET=service-token-client-secret
