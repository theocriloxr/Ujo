// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enterprise-Grade Smart Home Hub Schema

model Device {
  id           String   @id @default(uuid())
  name         String
  type         String   // light, lock, ac, pump, sensor
  state        String   // ON, OFF, LOCKED, UNLOCKED, or raw values
  category     String   @default("ESSENTIAL") // ESSENTIAL vs HEAVY
  isSheddable  Boolean  @default(true) // If true, system can auto-kill it to save battery
  powerUsage   Float    @default(0.0) // Watts
  lastActionAt DateTime @updatedAt
  status       String   @default("ONLINE")
}

model SystemConfig {
  id           String @id @default("GLOBAL")
  mode         String @default("STANDARD") // STANDARD, AWAY, DURESS_ACTIVE
  location     String @default("Home")
  powerSource  String @default("MAINS")    // MAINS, INVERTER
  autoShedding Boolean @default(true)
  version      String @default("3.1.0-alpha")
}

model Alert {
  id             String   @id @default(uuid())
  type           String   // SECURITY, ENERGY, SYSTEM
  severity       String   // HIGH, MEDIUM, LOW, CRITICAL
  message        String
  acknowledged   Boolean  @default(false)
  timestamp      DateTime @default(now())
}

model AccessProfile {
  id           String   @id @default(uuid())
  name         String
  pinHash      String
  role         String   @default("GUEST") // OWNER, STAFF, GUEST
  scheduleRaw  String?  // JSON string for allowed windows
  isTemporal   Boolean  @default(false)
  expiresAt    DateTime?
}

model EnergyTelemetry {
  id            Int      @id @default(autoincrement())
  timestamp     DateTime @default(now())
  voltage       Float
  current       Float
  frequency     Float
  reactivePower Float    @default(0.0)
  powerFactor   Float    @default(1.0)
  source        String   // MAINS or INVERTER
}

model SecurityAudit {
  id        String   @id @default(uuid())
  action    String   // PIN_ATTEMPT, PROFILE_CHANGE, GUEST_CODE_GEN, REVOCATION
  actor     String
  status    String   // SUCCESS, FAILURE
  timestamp DateTime @default(now())
  metadata  String?  // JSON
}

model GuestSession {
  id        String   @id @default(uuid())
  token     String   @unique
  name      String
  role      String   @default("GUEST")
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
}

model VoiceSettings {
  id         String @id @default("GLOBAL")
  persona    String @default("Ujo") // Ujo, Jarvis, Samantha
  pitch      Float  @default(1.0)
  speechRate Float  @default(1.0)
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  timestamp DateTime @default(now())
  meta      String?  // Extra JSON data
}

model HardwareNode {
  id              String   @id
  kind            String
  room            String?
  firmwareVersion String?
  status          String   @default("OFFLINE")
  provisioned     Boolean  @default(false)
  safetyClass     String   @default("STANDARD")
  allowedActions  String   @default("[]")
  lastSequence    Int      @default(-1)
  commandSequence Int      @default(0)
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
}

model HardwareCommand {
  id          String   @id @default(uuid())
  nodeId      String
  action      String
  value       String?
  status      String   @default("PENDING")
  requestedBy String
  reason      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  approvedAt  DateTime?
  completedAt DateTime?
  error       String?

  @@index([status, expiresAt])
  @@index([nodeId, createdAt])
}

model SensorTelemetry {
  id        Int      @id @default(autoincrement())
  nodeId    String
  kind      String
  payload   String
  timestamp DateTime @default(now())

  @@index([nodeId, timestamp])
  @@index([kind, timestamp])
}

model FoodReference {
  id                   String @id @default(uuid())
  sourceId             String @unique
  name                 String
  category             String
  pantryDaysMin        Int?
  pantryDaysMax        Int?
  refrigeratorDaysMin  Int?
  refrigeratorDaysMax  Int?
  freezerDaysMin       Int?
  freezerDaysMax       Int?
  afterOpeningDaysMax  Int?
  source               String @default("USDA FoodKeeper")
  sourceUrl            String

  @@index([name])
  @@index([category])
}

model InventoryItem {
  id                    String   @id @default(uuid())
  referenceId           String?
  name                  String
  category              String
  location              String
  storageMethod         String
  quantity              Float    @default(1)
  unit                  String   @default("item")
  acquiredAt            DateTime @default(now())
  openedAt              DateTime?
  labelExpiresAt        DateTime?
  expectedShelfLifeDays Int?
  consumedAt            DateTime?
  discardedAt           DateTime?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([location, storageMethod])
  @@index([labelExpiresAt])
}

model FoodObservation {
  id            Int      @id @default(autoincrement())
  itemId        String
  visualQuality Float?
  odorConcern   Boolean  @default(false)
  userConfirmed Boolean  @default(false)
  notes         String?
  timestamp     DateTime @default(now())

  @@index([itemId, timestamp])
}

model FoodZoneReading {
  id          Int      @id @default(autoincrement())
  nodeId      String
  location    String
  temperature Float?
  humidity    Float?
  ethylenePpm Float?
  vocIndex    Float?
  timestamp   DateTime @default(now())

  @@index([location, timestamp])
}

model ShoppingItem {
  id          String   @id @default(uuid())
  name        String
  quantity    Float    @default(1)
  unit        String   @default("item")
  reason      String?
  status      String   @default("NEEDED")
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status, createdAt])
}
