// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./ujo_os.db"
}

// Enterprise-Grade Smart Home Hub Schema

model Device {
  id           String   @id @default(uuid())
  name         String
  type         String   // light, lock, ac, pump, sensor
  state        String   // ON, OFF, LOCKED, UNLOCKED, or raw values
  category     String   @default("ESSENTIAL") // ESSENTIAL vs HEAVY
  trustZone    TrustZone @default(COMFORT)
  isSheddable  Boolean  @default(true) // If true, system can auto-kill it to save battery
  powerUsage   Float    @default(0.0) // Watts
  lastActionAt DateTime @updatedAt
  status       String   @default("ONLINE")
  healthTrends HealthTrend[]
}

model SystemConfig {
  id           String @id @default("GLOBAL")
  mode         String @default("STANDARD") // STANDARD, AWAY, DURESS_ACTIVE
  powerSource  String @default("MAINS")    // MAINS, INVERTER
  autoShedding Boolean @default(true)
  version      String @default("3.1.0-alpha")
}

model Alert {
  id             String   @id @default(uuid())
  type           String   // SECURITY, ENERGY, SYSTEM
  severity       String   // HIGH, MEDIUM, LOW, CRITICAL
  message        String
  acknowledged   Boolean  @default(false)
  timestamp      DateTime @default(now())
}

model AccessProfile {
  id           String   @id @default(uuid())
  name         String
  pinHash      String
  role         String   @default("GUEST") // OWNER, STAFF, GUEST
  scheduleRaw  String?  // JSON string for allowed windows
  isTemporal   Boolean  @default(false)
  expiresAt    DateTime?
}

model EnergyTelemetry {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  voltage   Float
  current   Float
  frequency Float
  source    String   // MAINS or INVERTER
}

enum TrustZone {
  CRITICAL
  COMFORT
  ADVISORY
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  trustLevel TrustZone?
  deviceZone TrustZone?
  timestamp DateTime @default(now())
  meta      String?  // Extra JSON data
}

model Resident {
  id String @id @default(uuid())
  homeId String
  name String
  role String // OWNER COADMIN STAFF GUEST
  voiceHash String?
  zones Json // ["CRITICAL", "COMFORT"]
  createdAt DateTime @default(now())
  
  inventoryItems InventoryItem[]
  conversationMemories ConversationMemory[]
}

model InventoryItem {
  id String @id @default(uuid())
  name String
  category String // DAIRY VEGETABLE MEAT etc
  lowThreshold Float @default(0.2)
  lastSeen DateTime?
  confidence Float @default(0.0)
  residentId String?
  resident Resident? @relation(fields: [residentId], references: [id])
}

model HealthTrend {
  id String @id @default(uuid())
  deviceId String
  metric String // power runtime temp
  trend Float
  confidence Float
  anomaly Boolean @default(false)
  device Device @relation(fields: [deviceId], references: [id])
}

model ConversationMemory {
  id String @id @default(uuid())
  residentId String
  context Json // {"lastTopic": "lights", "followup": true}
  timestamp DateTime @default(now())
  resident Resident @relation(fields: [residentId], references: [id])
}


